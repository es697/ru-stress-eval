(version 1)
(allow default)
(deny network*)
(deny file-write* (subpath "/Users/johndoe/Documents"))
(deny file-write* (subpath "/Users/johndoe/Desktop"))
(deny file-write* (subpath "/Users/johndoe/Downloads"))
(deny file-write* (subpath "/Users/johndoe/.ssh"))
(deny file-write* (subpath "/Users/johndoe/.gnupg"))
(deny file-write* (subpath "/Users/johndoe/Library/Keychains"))
(deny file-write* (subpath "/Users/johndoe/.aws"))
